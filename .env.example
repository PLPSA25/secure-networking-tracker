# Public — safe to expose in the browser
NEXT_PUBLIC_NEON_AUTH_URL="https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth"
NEXT_PUBLIC_NEON_DATA_API_URL="https://<endpoint>.apirest.<region>.aws.neon.tech/<db>/rest/v1"

# Server only — never commit a real value, never expose to the browser
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Test only — belongs in .env.test.local, not .env.local. Credentials for a
# dedicated throwaway account, used only to run `npm test` (the integration
# test signs in to exercise the CHECK constraints past RLS). Never commit a
# real value.
TEST_USER_EMAIL="test@example.com"
TEST_USER_PASSWORD="change-me"
